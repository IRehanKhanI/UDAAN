# ==========================================
# UDAAN Backend Environment Configuration
# ==========================================

# --- Core Django Settings ---
DJANGO_SECRET_KEY=replace-me-with-a-secure-random-secret-key
DJANGO_DEBUG=True

# Hosts allowed to connect. In development, '*' allows access from localhost and mobile devices on your local WiFi.
# For production, specify your exact domain (e.g., api.udaan.app,127.0.0.1).
DJANGO_ALLOWED_HOSTS=*

# --- CORS & CSRF (WiFi & Mobile Access) ---
# When True in development, mobile devices on the same WiFi can access the backend API seamlessly.
CORS_ALLOW_ALL_ORIGINS=True

# Additional origins for CORS and CSRF trusted origins:
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend application base URL (used for email invitation and verification links)
FRONTEND_BASE_URL=http://localhost:5173

# --- Database Configuration ---
# Choose 'sqlite' (zero configuration, default) or 'postgresql'
DB_ENGINE=sqlite
DB_NAME=db.sqlite3

# If using PostgreSQL (DB_ENGINE=postgresql):
DB_USER=udaan
DB_PASSWORD=replace-me-password
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Google Gemini AI Synthesis (Required for roadmap, mind map & stage generation) ---
# Get your API key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-1.5-flash

# --- Optional Secondary LLM Provider (Groq fallback when Gemini is busy) ---
# Get your API key at https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Live Web Discovery & Market Research ---
# Brave Search API for competitor and market discovery (https://brave.com/search/api/)
BRAVE_API_KEY=

# Tavily AI for deep competitor page content extraction (https://tavily.com/)
TAVILY_API_KEY=

# --- GitHub OAuth Integration ---
# Register an OAuth app at https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/api/auth/github/callback/

# --- Email & SMTP (Optional) ---
# Leave blank to use copyable invite links in development
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
