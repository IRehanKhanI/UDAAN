# ==========================================
# 1. CORE DJANGO SETTINGS
# ==========================================
DJANGO_SECRET_KEY=django-insecure-udaan-local-development-key-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:5173

# ==========================================
# 2. DATABASE (SQLite Only)
# ==========================================
DB_ENGINE=sqlite
DB_NAME=db.sqlite3
# Note: DB_USER, DB_PASSWORD, DB_HOST, DB_PORT are ignored when DB_ENGINE=sqlite

# ==========================================
# 3. AI SYNTHESIS (Required for Roadmaps & Stages)
# ==========================================
# Get free key at: https://aistudio.google.com/
GEMINI_API_KEY=AQ
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-1.5-flash

# Optional secondary fallback if Gemini hits rate limits (Get at https://console.groq.com/)
GROQ_API_KEY=gsk
GROQ_MODEL=llama-3.3-70b-versatile

# ==========================================
# 4. LIVE WEB RESEARCH & DISCOVERY (Optional)
# ==========================================
# Brave Search API (Get free key at https://brave.com/search/api/)
BRAVE_API_KEY=

# Tavily Deep Extraction API (Get free key at https://tavily.com/)
TAVILY_API_KEY=tvly

# ==========================================
# 5. GITHUB OAUTH (Optional - for GitHub Login)
# ==========================================
# Register app at https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/api/auth/github/callback/

# ==========================================
# 6. YOUTUBE LEARNING VIDEOS (Optional)
# ==========================================
# YouTube Data API v3 key for curated video search (https://console.developers.google.com/)
# If not set, UDAAN uses a trusted hand-curated fallback list (no API required)
YOUTUBE_API_KEY=

# ==========================================
# 7. EMAIL & SMTP (Optional)
# ==========================================
# Leave blank: UDAAN generates copyable invite links in development
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
