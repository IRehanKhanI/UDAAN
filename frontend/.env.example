# ==========================================
# UDAAN Frontend Environment Configuration
# ==========================================

# --- API Connection Configuration ---
# Mode 1 (RECOMMENDED for Localhost + Mobile WiFi access):
# Leave VITE_API_BASE_URL blank or commented out.
# The Vite dev server automatically proxies all '/api' calls to http://127.0.0.1:8000.
# Both your PC browser and mobile phone on WiFi will work seamlessly out of the box!
VITE_API_BASE_URL=

# Mode 2 (Direct Backend IP - only needed if you do NOT use Vite's dev proxy):
# VITE_API_BASE_URL=http://127.0.0.1:8000
# For direct mobile connection to Django backend (replace with your machine's WiFi IPv4 address):
# VITE_API_BASE_URL=http://10.139.50.66:8000

# ==========================================
# Dev Server URLs (when running: npm run dev)
# ==========================================
# Vite binds to 0.0.0.0:5173 and provides two URLs:
# 1. Local (PC):    http://localhost:5173/
# 2. Network (WiFi): http://<YOUR_WIFI_IP>:5173/ (e.g. http://10.139.50.66:5173/)
#
# Open the Network URL on your phone's browser while connected to the same WiFi network.
